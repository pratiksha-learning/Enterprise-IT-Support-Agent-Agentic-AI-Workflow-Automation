# Copy to backend/.env (or export as environment variables). NEVER commit real values.
# Defaults run the full demo locally in MOCK mode with no Microsoft 365 tenant.

# ---- general
ENVIRONMENT=local                 # local | dev | test | prod   (prod forbids AUTH_MODE=mock)
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/itsupport.db
# DATABASE_URL=postgresql+psycopg://itsupport:<password>@localhost:5432/itsupport
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_BASE_URL=http://localhost:8000

# ---- authentication
AUTH_MODE=mock                    # mock | entra
MOCK_JWT_SECRET=                  # >= 32 random chars; if empty a random per-process secret is generated
# ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_API_AUDIENCE=api://it-support-agent
# ENTRA_ALLOWED_CALLBACK_APP_IDS=<client-id-of-approval-flow-app>

# ---- adapters (mock = local simulation)
IDENTITY_PROVIDER=mock            # mock | graph
APPROVAL_PROVIDER=mock            # mock | power_automate
PROVISIONING_PROVIDER=mock        # mock | entra_groups   (entra_groups performs REAL grants)
ALLOW_REAL_PROVISIONING=false     # must be true to use entra_groups
NOTIFICATION_PROVIDER=mock        # mock | teams_webhook
KNOWLEDGE_SOURCE=local            # local | sharepoint
EMBEDDING_PROVIDER=local          # local | azure_openai
ANSWER_PROVIDER=local             # local | azure_openai

# ---- Microsoft Graph (client credentials) - only for graph / entra_groups / sharepoint
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=            # prefer Key Vault: KEY_VAULT_URL + secret "graph-client-secret"
# SHAREPOINT_SITE_ID=
# SHAREPOINT_DRIVE_ID=

# ---- Power Automate HTTP trigger URLs (contain SAS signatures = secrets)
# POWER_AUTOMATE_APPROVAL_FLOW_URL=
# POWER_AUTOMATE_NOTIFY_FLOW_URL=

# ---- Azure OpenAI (optional)
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# AZURE_OPENAI_CHAT_DEPLOYMENT=

# ---- secrets from Azure Key Vault (managed identity)
# KEY_VAULT_URL=https://<vault>.vault.azure.net/

# ---- workflow policy
APPROVAL_TIMEOUT_HOURS=72
GOVERNANCE_APPROVER_ID=u-grace

# ---- RAG
RAG_TOP_K=4
RAG_MIN_SCORE=0.22

# ---- protection
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=60

# ---- observability
OTEL_SERVICE_NAME=it-support-agent-api
OTEL_CONSOLE_EXPORT=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# APPLICATIONINSIGHTS_CONNECTION_STRING=
