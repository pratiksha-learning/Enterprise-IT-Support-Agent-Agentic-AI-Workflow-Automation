{
  "$comment": "Copilot Studio tool definition (configuration artifact). Mirrors backend/app/agents/tools.py and connector-openapi.yaml.",
  "name": "ListRequestableApplications",
  "connector_operation": "ListApplications",
  "description": "Returns the catalog of applications and roles employees can request, including role descriptions, whether a role is privileged and the maximum duration in days. Call this before collecting an access request.",
  "requires_user_confirmation": false,
  "inputs": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "outputs": {
    "type": "array",
    "items": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "privileged": {
                "type": "boolean"
              },
              "max_duration_days": {
                "type": "integer"
              }
            }
          }
        }
      }
    }
  }
}
