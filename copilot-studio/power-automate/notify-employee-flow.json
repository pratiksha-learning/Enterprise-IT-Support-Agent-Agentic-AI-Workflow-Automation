{
  "$comment": "Power Automate cloud flow definition for 'IT Agent - Notify Employee in Teams'. Called by the backend TeamsFlowNotificationProvider (NOTIFICATION_PROVIDER=teams_webhook). Reference artifact, not validated against a live tenant.",
  "properties": {
    "displayName": "IT Agent - Notify Employee in Teams",
    "connectionReferences": {
      "shared_teams": {
        "connectionName": "shared-teams",
        "source": "Embedded",
        "id": "/providers/Microsoft.PowerApps/apis/shared_teams"
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "Http",
          "inputs": {
            "triggerAuthenticationType": "All",
            "schema": {
              "type": "object",
              "required": [
                "recipient",
                "subject",
                "body"
              ],
              "properties": {
                "recipient": {
                  "type": "string"
                },
                "subject": {
                  "type": "string"
                },
                "body": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "actions": {
        "Post_message_as_Flow_bot_to_user": {
          "type": "OpenApiConnection",
          "runAfter": {},
          "inputs": {
            "host": {
              "connectionName": "shared_teams",
              "operationId": "PostMessageToConversation",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams"
            },
            "parameters": {
              "poster": "Flow bot",
              "location": "Chat with Flow bot",
              "body/recipient": "@triggerBody()?['recipient']",
              "body/messageBody": "<p><b>@{triggerBody()?['subject']}</b></p><p>@{triggerBody()?['body']}</p>"
            },
            "authentication": "@parameters('$authentication')"
          },
          "retryPolicy": {
            "type": "exponential",
            "count": 3,
            "interval": "PT10S"
          }
        },
        "Response_200": {
          "type": "Response",
          "kind": "Http",
          "runAfter": {
            "Post_message_as_Flow_bot_to_user": [
              "Succeeded"
            ]
          },
          "inputs": {
            "statusCode": 200
          }
        },
        "Response_502": {
          "type": "Response",
          "kind": "Http",
          "runAfter": {
            "Post_message_as_Flow_bot_to_user": [
              "Failed",
              "TimedOut"
            ]
          },
          "inputs": {
            "statusCode": 502
          }
        }
      },
      "outputs": {}
    }
  }
}