{
  "$comment": "Copilot Studio tool definition (configuration artifact). Mirrors backend/app/agents/tools.py and connector-openapi.yaml.",
  "name": "GetTicketStatus",
  "connector_operation": "GetTicketStatus",
  "description": "Gets the current status and priority of one of the signed-in user's IT tickets by ticket number (format INC followed by 7 digits, e.g. INC1001001).",
  "requires_user_confirmation": false,
  "inputs": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "ticket_number"
    ],
    "properties": {
      "ticket_number": {
        "type": "string",
        "pattern": "^[Ii][Nn][Cc]\\d{7}$",
        "description": "Ticket number such as INC1001001."
      }
    }
  },
  "outputs": {
    "type": "object",
    "properties": {
      "ticket_number": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "new",
          "in_progress",
          "on_hold",
          "resolved",
          "closed",
          "cancelled"
        ]
      },
      "priority": {
        "type": "string"
      },
      "updated_at": {
        "type": "string",
        "format": "date-time"
      }
    }
  }
}
